# Copy this file to .env (in this folder) and fill in the keys you need. .env is gitignored: never commit real values.
# On a server, set the same keys as environment variables instead (they win over the file), or point RISIPS_ENV at a file.

# --- environment ---
FP_ENV=sandbox                 # sandbox | production (live tenant: real money)
DEMO_MODE=1                    # sandbox only: OTPs in API responses, MF Central stand-in. Refused in production.
PORT=8080
PUBLIC_URL=https://api.example.com   # what the phone reaches (payment / mandate return pages, webhooks)
RISIPS_STATE_DIR=              # where uploads, logs and the embedded DB live (Azure: a folder under /home)

# --- database ---
DATABASE_URL=                  # postgres://user:pass@host:5432/risips?sslmode=require; REQUIRED in production (RDS).
                               # Empty: an embedded Postgres in <state>/data/pg (laptop / sandbox).

# --- security ---
APP_SECRET=                    # 32+ random characters; REQUIRED in production (signs file links, hashes OTPs)
TRUST_PROXY=1                  # reverse proxies in front (App Service / Caddy / ALB = 1); "false" when none
SESSION_IDLE_DAYS=30           # sign-out after this long unused
SESSION_MAX_DAYS=180           # and after this long in total
LOG_OTPS=                      # 1 prints OTPs to the server log (default: on in the sandbox, off in production)
RATE_LIMIT_SCALE=1             # multiplies every rate limit (1 = production limits)
LOG_LEVEL=info                 # debug | info | warn | error
FP_WEBHOOK_TOKEN=              # 24+ random characters; webhooks are off without it

# --- Admin API (read-only, /admin/v1) ---
ADMIN_API_KEY=                 # 24+ random characters; the Admin API is off (404) without it
ADMIN_API_ALLOWED_IPS=         # comma-separated caller IPs (the admin dashboard's server); empty = any

# --- FintechPrimitives: sandbox ---
FP_SANDBOX_CLIENT_ID=
FP_SANDBOX_CLIENT_SECRET=
FP_PV_SANDBOX_CLIENT_ID=
FP_PV_SANDBOX_CLIENT_SECRET=

# --- FintechPrimitives: production (FP_ENV=production) ---
FP_BASE_URL=
FP_TENANT=
FP_CLIENT_ID=
FP_CLIENT_SECRET=
FP_PV_BASE_URL=
FP_PV_AUTH_URL=
FP_PV_AUTH_TENANT=
FP_PV_CLIENT_ID=
FP_PV_CLIENT_SECRET=

# --- MF Central (all of them, or none: the sandbox stand-in is used) ---
MFC_BASE_URL=
MFC_CLIENT_ID=
MFC_CLIENT_SECRET=
MFC_USERNAME=
MFC_PASSWORD=
MFC_AES_KEY=
MFC_PRIVATE_JWK=
MFC_PUBLIC_JWK=
