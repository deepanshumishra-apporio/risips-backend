{
  "name": "risips-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/server.ts",
    "dev": "node --experimental-strip-types --disable-warning=ExperimentalWarning --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "catalog": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/build-catalog.ts && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fund-data.ts",
    "fund-data": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/fund-data.ts",
    "migrate-sqlite": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/migrate-sqlite.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "drizzle-orm": "0.45.4",
    "express": "^5.1.0",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "fflate": "^0.8.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.71.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
